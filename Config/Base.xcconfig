// Shared build settings for every target.
MACOSX_DEPLOYMENT_TARGET = 13.0
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
MARKETING_VERSION = 0.0.1
CURRENT_PROJECT_VERSION = 1
ENABLE_HARDENED_RUNTIME = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES
DEAD_CODE_STRIPPING = YES
GENERATE_INFOPLIST_FILE = NO

// Signing (851-2400): lil passwords ships under Alexandru Turcanu's Apple
// Developer team. The team ID isn't secret (it's embedded in every signed
// binary), and the helper's XPC code-signing requirement is derived from it.
//
// The default identity is ad-hoc ("-") with manual signing, so CI and
// contributors without the certificate can still build. To sign locally, set
// CODE_SIGN_IDENTITY in the gitignored Config/Local.xcconfig:
//   CODE_SIGN_IDENTITY = Apple Development              (day-to-day dev)
//   CODE_SIGN_IDENTITY = Developer ID Application       (release; see docs/releasing.md)
// Contributors on another team can also override DEVELOPMENT_TEAM there.
//
// Release builds (scripts/release/, 851-2436) re-sign everything inside out
// after the fact, with an ad hoc identity today or a real Developer ID
// identity once DEVELOPER_ID_CERT_P12/DEVELOPER_ID_CERT_PASSWORD/APPLE_TEAM_ID
// exist as repo/org secrets — independent of these build settings, which only
// govern this xcodebuild's own default signing. See docs/releasing.md.
DEVELOPMENT_TEAM = WH4QW9ND3J
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -

// Sparkle (851-2437): EdDSA public key baked into Info.plist as
// SUPublicEDKey. Empty placeholder until `generate_keys` produces a real
// keypair — UpdaterController treats an empty key as "no updater configured"
// and no-ops rather than starting Sparkle against a malformed key. See
// docs/releasing.md.
SPARKLE_PUBLIC_ED_KEY = X14W9JrQPEYH7UD8MUT+/bKsVkrMVpbnLAy360q6ffE=

#include? "Local.xcconfig"
