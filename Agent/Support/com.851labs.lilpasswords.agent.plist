<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.851labs.lilpasswords.agent</string>
	<!--
	BundleProgram (not Program/ProgramArguments) is how SMAppService-managed
	agent plists reference their executable: a path relative to the app
	bundle root, resolved by the system at registration time regardless of
	where the .app is installed. This must match where project.yml embeds the
	LilPasswordsAgent target (Contents/Helpers, alongside lilpw).
	-->
	<key>BundleProgram</key>
	<string>Contents/Helpers/LilPasswordsAgent</string>
	<!--
	Interactive, not Standard/Background: the agent needs to run in the user's
	Aqua session (WindowServer access) rather than headless, since a future
	unlock handoff (851-2427) may involve on-screen authentication UI.
	-->
	<key>ProcessType</key>
	<string>Interactive</string>
	<!--
	Still no RunAtLoad or KeepAlive: the agent has nothing useful to do until a
	client connects, so it stays registered-but-dormant until then rather than
	running (and holding a vault key in memory) the whole time the user is
	logged in.
	-->
	<key>MachServices</key>
	<dict>
		<!--
		Registers com.851labs.lilpasswords.agent.xpc with launchd. The first
		XPC connection to this name (from the app or lilpw, via
		NSXPCConnection(machServiceName:)) launches BundleProgram on demand;
		launchd tears it back down once every connection using the service goes
		away. Must match AgentXPC.machServiceName in LilPasswordsKit.
		-->
		<key>com.851labs.lilpasswords.agent.xpc</key>
		<true/>
	</dict>
</dict>
</plist>
