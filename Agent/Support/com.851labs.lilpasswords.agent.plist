<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.851labs.lilpasswords.agent</string>
	<!--
	BundleProgram (not Program/ProgramArguments) is how SMAppService-managed
	agent plists reference their executable: a path relative to the app
	bundle root, resolved by the system at registration time regardless of
	where the .app is installed. This must match where project.yml embeds the
	LilPasswordsAgent target (Contents/MacOS, alongside the main app binary).
	-->
	<key>BundleProgram</key>
	<string>Contents/MacOS/LilPasswordsAgent</string>
	<!--
	Interactive, not Standard/Background: the agent needs to run in the user's
	Aqua session (WindowServer access) rather than headless, since a future
	unlock handoff (851-2427) may involve on-screen authentication UI.
	-->
	<key>ProcessType</key>
	<string>Interactive</string>
	<!--
	No RunAtLoad, KeepAlive, or MachServices yet: with no trigger, launchd
	registers the job but never runs it, which is fine — the agent has nothing
	to do until 851-2427 wires up XPC (a MachServices entry will make launchd
	launch it on demand when a client connects).
	-->
</dict>
</plist>
